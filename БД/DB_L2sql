SELECT FILE_NAME
FROM DBA_DATA_FILES;

CREATE TABLESPACE TS_LSA
DATAFILE '/opt/oracle/oradata/FREE/FREEPDB1/TS_LSA.dbf'
SIZE 7M
AUTOEXTEND ON NEXT 5M
MAXSIZE 20M
EXTENT MANAGEMENT LOCAL;

SELECT TABLESPACE_NAME,
       STATUS,
       CONTENTS,
       EXTENT_MANAGEMENT
FROM DBA_TABLESPACES
WHERE TABLESPACE_NAME = 'TS_LSA';

SELECT FILE_NAME,
       TABLESPACE_NAME,
       BYTES / 1024 / 1024 AS SIZE_MB,
       AUTOEXTENSIBLE,
       INCREMENT_BY,
       MAXBYTES / 1024 / 1024 AS MAX_SIZE_MB
FROM DBA_DATA_FILES;



CREATE TEMPORARY TABLESPACE TS_LSA_TEMP
TEMPFILE '/opt/oracle/oradata/FREE/FREEPDB1/TS_LSA_TEMP.dbf'
SIZE 5M
AUTOEXTEND ON NEXT 3M
MAXSIZE 30M
EXTENT MANAGEMENT LOCAL;

SELECT FILE_NAME,
       TABLESPACE_NAME,
       STATUS,
       MAXBYTES,
       USER_BYTES
FROM DBA_DATA_FILES
UNION
SELECT FILE_NAME,
       TABLESPACE_NAME,
       STATUS,
       MAXBYTES,
       USER_BYTES
FROM DBA_TEMP_FILES;

CREATE ROLE RL_LSACORE;

GRANT CREATE SESSION,
      CREATE TABLE,
      CREATE VIEW,
      CREATE PROCEDURE
TO RL_LSACORE;

SELECT * FROM DBA_ROLES WHERE ROLE = 'RL_LSACORE';

SELECT * FROM DBA_SYS_PRIVS WHERE GRANTEE = 'RL_LSACORE';
SELECT * FROM ROLE_SYS_PRIVS WHERE ROLE = 'RL_LSACORE';

CREATE PROFILE PF_LSACORE LIMIT
    PASSWORD_LIFE_TIME 180
    SESSIONS_PER_USER 3
    FAILED_LOGIN_ATTEMPTS 7
    PASSWORD_LOCK_TIME 1
    PASSWORD_REUSE_TIME 10
    PASSWORD_GRACE_TIME DEFAULT
    CONNECT_TIME 180
    IDLE_TIME 30;
    
SHOW PARAMETER RESOURCE_LIMIT;
SELECT NAME, VALUE
FROM V$PARAMETER
WHERE NAME = 'resource_limit';

SELECT * FROM DBA_PROFILES WHERE PROFILE = 'PF_LSACORE'
ORDER BY RESOURCE_TYPE, RESOURCE_NAME;

SELECT * FROM DBA_PROFILES WHERE PROFILE = 'DEFAULT'
ORDER BY RESOURCE_TYPE, RESOURCE_NAME;

SELECT DISTINCT PROFILE
FROM DBA_PROFILES;

CREATE USER LSACORE
IDENTIFIED BY qwerty123
DEFAULT TABLESPACE TS_LSA
TEMPORARY TABLESPACE TS_LSA_TEMP
PROFILE PF_LSACORE
ACCOUNT UNLOCK
PASSWORD EXPIRE;

GRANT RL_LSACORE TO LSACORE;

ALTER USER LSACORE QUOTA 20M ON TS_LSA;

SELECT USERNAME,
       ACCOUNT_STATUS,
       DEFAULT_TABLESPACE,
       TEMPORARY_TABLESPACE,
       PROFILE
FROM DBA_USERS
WHERE USERNAME = 'LSACORE';

SELECT * FROM DBA_ROLE_PRIVS WHERE GRANTEE = 'LSACORE';
SELECT * FROM DBA_TS_QUOTAS WHERE USERNAME = 'LSACORE';

